<Window x:Class="ReadX.Views.RsvpOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="520"
        Height="180"
        Background="#F2141820"
        Foreground="#F8FAFC"
        AllowsTransparency="True"
        KeyDown="Window_KeyDown">
    <Border BorderBrush="#52616F" BorderThickness="1" CornerRadius="8" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LeftWordText"
                           Grid.Column="0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="48"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="FocusLetterText"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="48"
                           FontWeight="SemiBold"
                           Foreground="#EF4444"
                           TextAlignment="Center" />

                <TextBlock x:Name="RightWordText"
                           Grid.Column="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="48"
                           FontWeight="SemiBold"
                           TextAlignment="Left"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <ProgressBar x:Name="Progress"
                         Grid.Row="1"
                         Minimum="0"
                         Maximum="1"
                         Height="4"
                         BorderThickness="0"
                         Foreground="#38BDF8"
                         Background="#334155" />

            <TextBlock x:Name="FooterText"
                       Grid.Row="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="#CBD5E1" />
        </Grid>
    </Border>
</Window>
